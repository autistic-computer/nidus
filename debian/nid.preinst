#!/bin/sh
set -eu
case "$1" in
    install|upgrade)
        if [ -e /usr/local/bin/nid ] || [ -e /usr/local/bin/nidd ] ||
           { [ -f /etc/systemd/system/nidd.service ] && grep -q /usr/local/bin/nidd /etc/systemd/system/nidd.service; }; then
            echo 'An archive/source installation is present. Continue updating with the curl installer, or follow the migration instructions in packaging/README.md before installing a .deb.' >&2
            exit 1
        fi
        ;;
esac
#DEBHELPER#
