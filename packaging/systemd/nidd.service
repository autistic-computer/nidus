[Unit]
Description=Nidus headless input-sharing daemon
Documentation=https://github.com/autistic-computer/nidus
Wants=systemd-udevd.service
After=local-fs.target systemd-udevd.service

[Service]
Type=notify
NotifyAccess=main
User=nid
Group=nid
ExecStartPre=/usr/bin/test -c /dev/uinput
ExecStart=/usr/local/bin/nidd --config /etc/nid/nid.toml
Restart=on-failure
RestartSec=250ms
TimeoutStartSec=15s
TimeoutStopSec=2s
WatchdogSec=2s
WatchdogSignal=SIGKILL
KillMode=control-group

StateDirectory=nid
StateDirectoryMode=0700
RuntimeDirectory=nid nid-gui
RuntimeDirectoryMode=0750
UMask=0077

DevicePolicy=closed
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input r
PrivateDevices=no

NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/etc/nid
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
