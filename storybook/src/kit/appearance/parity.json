      "hover": "button:System"
    },
    {
      "name": "press-system",
      "section": "page",
      "press": "button:System"
    },
    {
      "name": "pick-system",
      "section": "page",
      "click": "button:System"
    },
    {
      "name": "pick-light",
      "section": "page",
      "click": "button:Light"
    },
    {
      "name": "pick-blue",
      "section": "page",
      "click": "settings-accent-blue"
