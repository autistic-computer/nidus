    },
    {
      "name": "toggle-contrast",
      "section": "narrow",
      "click": "settings-increase-contrast"
    },
    {
      "name": "hover-theme",
      "section": "page",
      "hover": "settings-theme"
    },
    {
      "name": "open-theme",
      "section": "page",
      "click": "settings-theme"
    },
    {
      "name": "theme-down",
      "section": "page",
      "key": "ArrowDown"
    },
    {
      "name": "theme-down-again",
      "section": "page",
      "key": "ArrowDown"
    },
    {
      "name": "theme-up",
      "section": "page",
      "key": "ArrowUp"
    },
    {
      "name": "theme-enter",
      "section": "page",
      "key": "Enter"
    },
    {
      "name": "collapse-advanced",
      "section": "narrow",
      "click": "settings-appearance-advanced"
    },
    {
      "name": "hover-custom",
      "section": "page",
      "hover": "settings-accent-custom"
